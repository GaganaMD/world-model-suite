# Copy this file to .env and add your OpenRouter key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional run settings. The defaults below are used when these are omitted.
OPENROUTER_MODELS=openai/gpt-5.6-sol,anthropic/claude-opus-5,meta-llama/llama-3.3-70b-instruct,qwen/qwen3.8-27b,deepseek/deepseek-v4-flash-0731
OPENROUTER_SAMPLES_PER_CASE=1
OPENROUTER_TIMEOUT_SECONDS=300
OPENROUTER_MAX_RETRIES=3
OPENROUTER_MAX_TOKENS=8192

